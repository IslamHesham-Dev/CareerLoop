# Server configuration. Never commit a real .env file.
# Select one backend-only LLM provider. The iHQ LiteLLM proxy is the recommended
# workshop deployment because the assigned key has a managed team budget.
LLM_PROVIDER=litellm
LITELLM_API_KEY=sk-your-ihq-team-key
LITELLM_MODEL=anthropic/claude-haiku-4-5
LITELLM_BASE_URL=https://litellm.i-hq.tech/v1

# Optional OpenRouter fallback. Set LLM_PROVIDER=openrouter to use these.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_APP_URL=https://careerloop.onrender.com
OPENROUTER_APP_TITLE=CareerLoop

# Optional Anthropic fallback. Set LLM_PROVIDER=anthropic to use these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional. Lets get_company_jobs find a company's real careers page via a
# Google search (Serper) instead of only guessing a Greenhouse/Lever/Ashby
# URL from the company name. Get a key at serper.dev. Leave blank to fall
# back to the URL-guessing path only.
SERPER_API_KEY=
DEGREELENS_ENVIRONMENT=development
DEGREELENS_SESSION_TTL_MINUTES=45
DEGREELENS_CURRENT_SEASON=Winter 2024
DEGREELENS_ADVISORY_YEAR=2024-2025
DEGREELENS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Fastest demo: an internal Notion connection and a page shared with it.
# On Render, add these under Environment for the backend web service. Common
# aliases NOTION_INTEGRATION_TOKEN and NOTION_PAGE_ID are also accepted.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Multi-user alternative: configure a public Notion connection.
# Leave the two values above empty when using OAuth.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/v1/integrations/notion/callback
NOTION_API_VERSION=2026-03-11

# GitHub OAuth App client ID. Enable Device Flow in the OAuth App settings.
# No GitHub client secret is required or shipped to the mobile app.
GITHUB_OAUTH_CLIENT_ID=

# Gmail send-only OAuth for reviewed job applications. Configure these on the
# backend/Render service only; never expose the client secret to Flutter.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/integrations/gmail/callback

# The prototype ignores contact emails found in LinkedIn posts and always sends
# to this server-controlled test inbox.
CAREERLOOP_PROTOTYPE_APPLICATION_RECIPIENT=islammheshamm7@gmail.com
