# Server configuration. Never commit a real .env file.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
DEGREELENS_ENVIRONMENT=development
DEGREELENS_SESSION_TTL_MINUTES=45
DEGREELENS_CURRENT_SEASON=Winter 2024
DEGREELENS_ADVISORY_YEAR=2024-2025
DEGREELENS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Fastest demo: an internal Notion connection and a page shared with it.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Multi-user alternative: configure a public Notion connection.
# Leave the two values above empty when using OAuth.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/v1/integrations/notion/callback
NOTION_API_VERSION=2026-03-11
